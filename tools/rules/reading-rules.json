{
 "version": 4,
 "rules": [
  {
   "id": "chunk.brackets",
   "kind": "split_guard",
   "scope": [
    "chunk"
   ],
   "lang": [
    "vi",
    "en"
   ],
   "priority": 0,
   "params": {
    "brackets_open": "([{",
    "brackets_close": ")]}",
    "quotes": "\"“”",
    "cite_abbrev": "fig no st mr mrs ms dr prof vs etc ie eg am pm tr tp nxb p pp ch sec vol ed",
    "overrun_words": "8",
    "overrun_chars_mult": "2"
   }
  },
  {
   "id": "drop.page_number",
   "kind": "drop_line",
   "scope": [
    "segment"
   ],
   "lang": [
    "vi",
    "en"
   ],
   "priority": 0,
   "patterns": [
    "^\\s*[-–—\\[\\({]*\\s*\\d{1,4}\\s*[-–—\\]\\)}]*\\s*$",
    "(?i)^\\s*(?:[-–—\\[\\({]*\\s*)?(?:trang|page)\\s+\\d{1,4}\\s*(?:[-–—\\]\\)}]*\\s*)?$"
   ]
  },
  {
   "id": "start.first_chapter",
   "kind": "start_marker",
   "scope": [
    "segment"
   ],
   "lang": [
    "vi",
    "en"
   ],
   "priority": 0,
   "pattern": "(?i)^\\s*(?:#+\\s*)?(chương|phần|tập|hồi|quyển|truyện|chuyện|mục|book|part|chapter)\\s+(1|01|một|nhất|đầu|thứ nhất|first|one|i)\\b"
  },
  {
   "id": "start.intro",
   "kind": "start_marker",
   "scope": [
    "segment"
   ],
   "lang": [
    "vi",
    "en"
   ],
   "priority": 0,
   "pattern": "(?i)^\\s*(?:#+\\s*)?(lời\\s+(giới thiệu|nói đầu|dẫn|tựa|tác giả|mở đầu)|mở đầu|phần mở đầu|prologue|preface|foreword|introduction)\\b"
  },
  {
   "id": "drop.toc_leader",
   "kind": "drop_line",
   "scope": [
    "segment"
   ],
   "lang": [
    "vi",
    "en"
   ],
   "priority": 1,
   "patterns": [
    ".{4,}?\\.{3,}\\s*\\d{1,4}\\s*$"
   ]
  },
  {
   "id": "drop.pageno_inline",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "vi",
    "en"
   ],
   "priority": 8,
   "pattern": "(?i)\\[Pg\\.?\\s*\\d{1,4}\\]",
   "template": ""
  },
  {
   "id": "date.full",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "vi"
   ],
   "priority": 9,
   "pattern": "(?i)(?:ngày\\s+)?\\b([0-3]?\\d)\\s*[/\\-.]\\s*([01]?\\d)\\s*[/\\-.]\\s*(\\d{2}|\\d{4})\\b",
   "template": "{day:1} tháng {month:2} năm {year:3}"
  },
  {
   "id": "date.slash_short",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "vi"
   ],
   "priority": 10,
   "pattern": "(?i)(?:ngày\\s+)?\\b([0-3]?\\d)\\s*/\\s*([01]?\\d)\\b",
   "template": "{day:1} tháng {month:2}"
  },
  {
   "id": "temp.celsius",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "vi"
   ],
   "priority": 12,
   "pattern": "(?i)(\\d)\\s*°\\s*C\\b",
   "template": "{1} độ C"
  },
  {
   "id": "temp.fahrenheit",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "vi"
   ],
   "priority": 13,
   "pattern": "(?i)(\\d)\\s*°\\s*F\\b",
   "template": "{1} độ F"
  },
  {
   "id": "temp.stuck",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "vi"
   ],
   "priority": 14,
   "pattern": "(?i)(\\d)\\s*(độ)",
   "template": "{1} {2}"
  },
  {
   "id": "roman.range",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "vi"
   ],
   "priority": 29,
   "pattern": "(?i)\\b(thế\\s+kỷ|kỷ|chương|phần|hồi|tập|quyển|mục|điều|khoản|phụ\\s+lục)\\s+([IVXLCDM]+)\\s*[-–—_]\\s*([IVXLCDM]+)\\b",
   "template": "{1} {roman:2} đến {1} {roman:3}"
  },
  {
   "id": "roman.single",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "vi"
   ],
   "priority": 30,
   "pattern": "(?i)\\b(thế\\s+kỷ|kỷ|chương|phần|hồi|tập|quyển|mục|điều|khoản|phụ\\s+lục)\\s+([IVXLCDM]+)([^A-Za-z0-9À-ɏḀ-ỹ]|$)",
   "template": "{1} {roman:2}{3}"
  },
  {
   "id": "fig.en",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "en"
   ],
   "priority": 31,
   "pattern": "(?i)\\bfig\\.\\s*(\\d{1,4})\\b",
   "template": "figure {1}"
  },
  {
   "id": "fig.vi",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "vi"
   ],
   "priority": 31,
   "pattern": "(?i)\\bfig\\.\\s*(\\d{1,4})\\b",
   "template": "hình {1}"
  },
  {
   "id": "no.en",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "en"
   ],
   "priority": 32,
   "pattern": "(?i)\\bno\\.\\s*(\\d{1,4})\\b",
   "template": "number {1}"
  },
  {
   "id": "no.vi",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "vi"
   ],
   "priority": 32,
   "pattern": "(?i)\\bno\\.\\s*(\\d{1,4})\\b",
   "template": "số {1}"
  },
  {
   "id": "abbrev.eg.en",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "en"
   ],
   "priority": 33,
   "pattern": "(?i)\\be\\.g\\.",
   "template": "for example"
  },
  {
   "id": "abbrev.eg.vi",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "vi"
   ],
   "priority": 33,
   "pattern": "(?i)\\be\\.g\\.",
   "template": "ví dụ"
  },
  {
   "id": "abbrev.etc.en",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "en"
   ],
   "priority": 33,
   "pattern": "(?i)\\betc\\.",
   "template": "and so on"
  },
  {
   "id": "abbrev.etc.vi",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "vi"
   ],
   "priority": 33,
   "pattern": "(?i)\\betc\\.",
   "template": "vân vân"
  },
  {
   "id": "abbrev.ie.en",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "en"
   ],
   "priority": 33,
   "pattern": "(?i)\\bi\\.e\\.",
   "template": "that is"
  },
  {
   "id": "abbrev.ie.vi",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "vi"
   ],
   "priority": 33,
   "pattern": "(?i)\\bi\\.e\\.",
   "template": "nghĩa là"
  },
  {
   "id": "abbrev.vs.en",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "en"
   ],
   "priority": 33,
   "pattern": "(?i)\\bvs\\.",
   "template": "versus"
  },
  {
   "id": "abbrev.vs.vi",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "vi"
   ],
   "priority": 33,
   "pattern": "(?i)\\bvs\\.",
   "template": "so với"
  },
  {
   "id": "paren.comma",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "vi",
    "en"
   ],
   "priority": 34,
   "pattern": "(\\s*)\\(([^()]{1,200}?)\\)(\\s*[.,!?;:]?)",
   "template": ", {2}{3}"
  },
  {
   "id": "paren.dup",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "vi",
    "en"
   ],
   "priority": 35,
   "pattern": ",(\\s*,)+",
   "template": ","
  },
  {
   "id": "paren.leftover",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "vi",
    "en"
   ],
   "priority": 35,
   "pattern": "[()]",
   "template": ""
  },
  {
   "id": "paren.start",
   "kind": "rewrite",
   "scope": [
    "tts"
   ],
   "lang": [
    "vi",
    "en"
   ],
   "priority": 36,
   "pattern": "^[\\s,]+",
   "template": ""
  }
 ],
